NODE_ENV=development
PORT=3000
INSTANCE_ID=local-1
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
# Leave empty for single-instance dev; set to enable the Redis Streams adapter + shared presence.
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-secret-please-change-me-32-bytes
JWT_TTL_SECONDS=86400
LOG_LEVEL=info
PRESENCE_TTL_SECONDS=60
RECOVERY_WINDOW_MS=120000
SENTRY_DSN=
